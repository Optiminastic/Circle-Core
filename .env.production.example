# ─────────────────────────────────────────────────────────────────────────────
# circle-be PRODUCTION env (Hetzner VPS + Docker Compose).
# Copy to `.env` on the server and fill in real values. NEVER commit the real
# .env — only this placeholder template is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres runs on the VPS (the `db` compose service). Use the SAME password in
# POSTGRES_PASSWORD and inside DATABASE_URL. Data is migrated in from Neon once
# (see DEPLOY.md).
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql+psycopg://circle:change-me-to-a-strong-password@db:5432/circle
AUTO_CREATE_TABLES=true

# The Docker network avora's Caddy is on (so it can reach circle-be-api by name).
# Verify with:  docker inspect deploy-caddy-1 -f '{{range $k,$_ := .NetworkSettings.Networks}}{{$k}}{{end}}'
PROXY_NETWORK=deploy_default

# Allowed browser origin = the Vercel-hosted frontend. Required in production.
CORS_ORIGINS=https://circle.optiminastic.com
FRONTEND_URL=https://circle.optiminastic.com

LOG_LEVEL=INFO

# ── Object storage (Backblaze B2 / S3) — copy from the Render dashboard ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
# AWS_S3_ENDPOINT=        # only for non-AWS S3-compatible providers (B2/MinIO)
# AWS_S3_PREFIX=
MAX_UPLOAD_MB=15

# ── Email: Gmail SMTP as careers@optiminastic.com (leave the HTTP-API keys blank
#    so the plain-SMTP transport is used). Outbound 587 is allowed on Hetzner. ──
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=careers@optiminastic.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=careers@optiminastic.com
SMTP_FROM_NAME=Optiminastic HR Team
SMTP_REPLY_TO=careers@optiminastic.com
HR_CC_EMAIL=careers@optiminastic.com
# Must be a sender the SMTP/Resend account above is authorized to send as.
NOTIFICATION_FROM_EMAIL=notification@optiminastic.com

# ── Google Calendar OAuth — copy client id/secret from the Render dashboard ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.circle.optiminastic.com/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary

# Optional: token-gated candidate handoff feed (blank = disabled / 404).
CANDIDATE_FEED_TOKEN=

# Optional: push employee changes to id-sync (blank = disabled). Signed with INTERNAL_API_SECRET.
IDSYNC_PUSH_URL=http://172.18.0.1:8017/directory/employees/push

# Avora reads ONE employee's pay, bank details and documents server-to-server
# (/api/internal/avora/*). Separate from INTERNAL_API_SECRET on purpose: id-sync
# holds that one and must never read salaries. Blank = endpoints answer 503.
AVORA_API_SECRET=

# ── OnGrid background verification (production community) ──
# Credentials are per-environment AND per-community: the staging pair does not
# work against api.ongrid.in and vice versa. The code default is staging, so a
# deploy that leaves these blank runs no checks rather than billing real ones.
ONGRID_BASE_URL=https://api.ongrid.in/app
ONGRID_USERNAME=optiminastic
ONGRID_PASSWORD=
ONGRID_COMMUNITY_ID=187363
# Id of the reference questionnaire OnGrid creates inside the community. It is
# not exposed by any endpoint and is community-specific, so the staging id is
# useless here - ask OnGrid for the production one. Blank = PRC cannot run and
# every other check is unaffected.
ONGRID_PRC_SCHEMA_ID=

# AI screening calls (Vapi). HR starts a call from the candidate page; Vapi
# reports back to /api/vapi/webhook. Private key = phone calls, public key =
# browser test calls. Blank phone number id = phone mode off (web tests work).
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_PHONE_NUMBER_ID=
# Shared secret Vapi sends on every webhook (Vapi credential, X-Vapi-Secret header).
VAPI_WEBHOOK_SECRET=
# Signature authentication, preferred over the shared secret above. Attach an
# HMAC credential to the server URL in Vapi and set these to match it: SHA-256,
# hex, signature header below, payload format "{timestamp}.{body}". The secret
# then never crosses the wire, the signature covers the body, and the timestamp
# bounds how long a captured request stays usable. Blank = the shared secret
# above is used instead, so the two can be switched over without downtime.
VAPI_WEBHOOK_SIGNING_SECRET=
VAPI_WEBHOOK_SIGNATURE_HEADER=x-signature
# Blank = Vapi is sending the body-only payload format, which gives up replay
# protection. Leave it set unless Vapi is configured without a timestamp.
VAPI_WEBHOOK_TIMESTAMP_HEADER=x-timestamp
VAPI_LLM_PROVIDER=openai
VAPI_LLM_MODEL=gpt-4o-mini
# Where Vapi posts call events (must be public https).
VAPI_WEBHOOK_URL=https://api.circle.optiminastic.com/api/vapi/webhook
# Public https URL of voice_bridge/ (Sarvam speech-to-text / text-to-speech).
VOICE_BRIDGE_URL=https://voice.circle.optiminastic.com
# Bearer token Vapi presents to the bridge; the bridge holds the same value.
VOICE_BRIDGE_SECRET=
# Read by the voice-bridge container only.
SARVAM_API_KEY=
