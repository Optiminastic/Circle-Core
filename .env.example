# Copy to .env and fill in your PostgreSQL connection string.
# Accepts postgresql://  or  postgresql+psycopg://  (postgres:// is also normalized).
DATABASE_URL=postgresql://user:password@localhost:5432/curcle

# Create the resource tables (id TEXT PK, data JSONB) if they don't exist.
# Set to false if your database schema is managed elsewhere.
AUTO_CREATE_TABLES=true

# Comma-separated list of allowed browser origins (the frontend).
# REQUIRED in production: include the deployed frontend domain(s), or the browser
# blocks API calls (the usual "frontend can't reach backend in prod" cause).
# localhost + private-LAN origins are always allowed via a built-in regex.
# Prod example: CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

LOG_LEVEL=INFO

# AWS S3 document storage. Leave blank to disable uploads. For an S3-compatible
# provider (e.g. Backblaze B2 / MinIO), also set AWS_S3_ENDPOINT to its endpoint.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
# Optional "folder" prefix all objects are stored under, e.g. Circle.
# AWS_S3_PREFIX=
# AWS_S3_ENDPOINT=   # only for non-AWS S3-compatible providers
MAX_UPLOAD_MB=15

# Email. Three transports, tried in this order (first one configured wins):
#  1) Resend HTTP API — set RESEND_API_KEY, OR just point the SMTP creds at Resend
#     (SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=re_...) and the
#     key is derived automatically. Works on hosts that block outbound SMTP (e.g.
#     Render free tier). Verify your domain at resend.com/domains first.
#  2) SendGrid HTTP API — set SENDGRID_API_KEY + a SendGrid-verified SMTP_FROM_EMAIL.
#  3) Plain SMTP (Gmail/Workspace app password, etc.) — used when no HTTP API key
#     is configured. NOTE: outbound SMTP is blocked on Render free tier — use
#     Resend/SendGrid there.
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Optiminastic Careers
# Optional Reply-To (where candidate replies land); falls back to the From address.
SMTP_REPLY_TO=hr@optiminastic.com
# CC the HR mailbox(es) on all recruitment emails (interview invites, the
# Physical Interview pack, test invites/results, decisions). Comma-separated
# for multiple mailboxes. Blank disables it.
HR_CC_EMAIL=hr@optiminastic.com,hr2@optiminastic.com
# Sender for early-pipeline candidate emails (OTP, application received, HR Call
# scheduling) — plain notification address, never CC'd to HR. Must be a sender
# your SMTP/Resend account is authorized to send as, or delivery will fail.
NOTIFICATION_FROM_EMAIL=notification@optiminastic.com

# Google Calendar sync (single shared HR account, one-way push). Leave blank to
# disable — scheduling still works, events just won't be pushed.
# Create a Google Cloud project, enable the Google Calendar API, configure the
# OAuth consent screen, and create an OAuth 2.0 "Web application" client whose
# Authorized redirect URI is the GOOGLE_REDIRECT_URI below. Then connect the
# shared account once from the in-app Settings page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary
FRONTEND_URL=http://localhost:3001

# Candidate handoff feed. Curcle hosts ONE public, token-gated URL the external
# onboarding system fetches to get every candidate HR has marked "arrived in
# office" (curated fields + verified document links). Set a long random secret;
# the feed URL is then  <API>/api/candidate-feed/<CANDIDATE_FEED_TOKEN>  — share
# that full URL with the receiving team. Blank = feed disabled (404).
CANDIDATE_FEED_TOKEN=

# Dashboard login sessions (httpOnly cookie).
# SESSION_SECRET: set a fixed, long random string in prod so logins survive
# restarts/deploys (if blank, it derives from another secret — and if THAT rotates,
# everyone gets logged out). Generate e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# How long a login stays valid with NO activity. Every app load refreshes it
# (sliding), so active users stay signed in. Default 720 = 30 days.
SESSION_TTL_HOURS=720

# OnGrid background-verification API (Basic auth). Onboards a hired candidate
# into the community; HR triggers the actual checks in OnGrid's portal.
# base URL points at the /app basePath (staging shown).
ONGRID_BASE_URL=https://api-staging.ongrid.in/app
ONGRID_USERNAME=
ONGRID_PASSWORD=
ONGRID_COMMUNITY_ID=
# Id of the reference questionnaire OnGrid creates inside the community - not
# exposed by any endpoint, and different per community, so ask OnGrid for it.
# Blank = PRC cannot run; every other check is unaffected.
ONGRID_PRC_SCHEMA_ID=

# AI screening calls (Vapi). HR starts a call from the candidate page; Vapi
# reports back to /api/vapi/webhook. Private key = phone calls, public key =
# browser test calls. Blank phone number id = phone mode off (web tests work).
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_PHONE_NUMBER_ID=
# Shared secret Vapi sends on every webhook (Vapi credential, X-Vapi-Secret header).
VAPI_WEBHOOK_SECRET=
VAPI_LLM_PROVIDER=openai
VAPI_LLM_MODEL=gpt-4o-mini
# Where Vapi posts call events (must be public https).
VAPI_WEBHOOK_URL=
# Public https URL of voice_bridge/ (Sarvam speech-to-text / text-to-speech).
VOICE_BRIDGE_URL=
# Bearer token Vapi presents to the bridge; the bridge holds the same value.
VOICE_BRIDGE_SECRET=
# Read by the voice-bridge container only.
SARVAM_API_KEY=

# Document OCR (app/services/ocr.py). Reads Aadhaar/PAN/address/education values
# off uploaded joining documents for HR to confirm. Self-hosted Tesseract, so
# the images never leave our infrastructure.
# Leave blank on Linux/Docker - the Dockerfile installs tesseract-ocr on PATH.
# On Windows the installer does not update PATH for running processes, so set
# the binary explicitly (forward slashes are fine):
#   OCR_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Unset and not on PATH = parsing is skipped and HR enters values manually.
OCR_TESSERACT_CMD=

# Push employee changes to id-sync as they happen (blank = disabled).
# Signed with INTERNAL_API_SECRET, the secret id-sync already uses to read the export.
IDSYNC_PUSH_URL=

# Avora reads ONE employee's pay, bank details and documents server-to-server
# (/api/internal/avora/*). Separate from INTERNAL_API_SECRET on purpose: id-sync
# holds that one and must never read salaries. Blank = endpoints answer 503.
AVORA_API_SECRET=
